t meta = [\"QRF PLOT\", \"WAITING\"];\n    let body = \"当前聊天尚无完整 qrf_plot，剧情推进完成后会自动刷新。\";\n    if (value.status === \"complete\") {\n      title = \"最近完整运行状态\";\n      meta = [\"QRF PLOT\", Number.isInteger(value.messageIndex) && value.messageIndex >= 0 ? `消息 #${value.messageIndex + 1}` : \"当前聊天\"];\n      body = value.text;\n    } else if (value.status === \"legacy\") {\n      title = \"旧聊天运行状态（只读）\";\n      meta = [\"LEGACY DB\", \"READ ONLY\", value.qrfStatus === \"invalid\" ? \"QRF PARTIAL\" : \"NO QRF\"];\n      body = value.qrfStatus === \"invalid\"\n        ? \"当前 qrf_plot 损坏或尚未完成；下方行动、伤势与持续状态暂从旧版数据库表只读展示，且不会回写。\"\n        : \"当前聊天没有 qrf_plot；下方行动、伤势与持续状态来自旧版数据库表，只读展示且不会回写。\";\n    } else if (value.status === \"invalid\") {\n      title = \"等待完整剧情包\";\n      meta = [\"QRF PLOT\", \"PARTIAL\"];\n      body = \"检测到损坏或尚未完成的 qrf_plot；不会沿用本次无效内容，等待后续更新。\";\n    }\n    return panel(\"剧情运行状态\", \"RUNTIME STATE\", `<article class=\"dls-v2-fact dls-runtime-state\" data-runtime-state=\"${dlsEsc(value.status || \"waiting\")}\">\n      <h4>${dlsEsc(title)}</h4>\n      ${metaChips(meta)}\n      <p data-runtime-state-text>${dlsEsc(body)}</p>\n    </article>`, true, \"dls-runtime-panel\");\n  }\n\n  function renderTop(model) {\n    const p = model.player;\n    const a = model.action;\n    const titleDisplay = model.titles.slots.map(slot => `<span class=\"dls-hero-title-slot\" data-equipped=\"${slot.valid ? \"true\" : \"false\"}\" data-title-slot=\"${dlsEsc(slot.slot)}\"><b>${dlsEsc(slot.slot)}</b><strong>${dlsEsc(slot.title ? slot.title.title_name : \"未装备\")}</strong></span>`).join(\"\");\n    return `<section class=\"dls-top\">\n      <div class=\"dls-meta\">\n        <span class=\"dls-chip\"><strong>时间</strong>${dlsEsc(p.time)}</span>\n        <span class=\"dls-chip\"><strong>地点</strong>${dlsEsc(p.location)}</span>\n        <span class=\"dls-chip\"><strong>时代</strong>${dlsEsc(p.era)}</span>\n        <button class=\"dls-theme-toggle\" type=\"button\" data-status-action=\"theme-toggle\" aria-pressed=\"${DLS_ROOT.dataset.theme === \"starsea\" ? \"true\" : \"false\"}\" aria-label=\"切换视觉主题\" title=\"切换视觉主题\"><span>视觉主题</span><strong data-dls-theme-label>${dlsEsc(dlsThemeLabel(DLS_ROOT.dataset.theme))}</strong></button>\n      </div>\n      <div class=\"dls-hero\">\n        <div class=\"dls-avatar-control\">\n          <button class=\"dls-avatar\" type=\"button\" data-status-action=\"avatar-upload\" aria-label=\"上传玩家头像\" title=\"点击上传玩家头像\">\n            <img data-dls-avatar-image alt=\"玩家头像\" hidden>\n            <span data-dls-avatar-fallback>${dlsEsc(p.name.charAt(0) || \"魂\")}</span>\n            <small>上传</small>\n          </button>\n          <input type=\"file\" accept=\"image/*\" data-dls-avatar-input hidden>\n        </div>\n        <div class=\"dls-identity\">\n          <div class=\"dls-name-row\"><h2 class=\"dls-name\">${dlsEsc(p.name)}</h2><span class=\"dls-badge\">${dlsEsc([p.realm, p.level].filter(Boolean).join(\" · \") || \"境界未记录\")}</span></div>\n          <div class=\"dls-subtitle\"><span>${dlsEsc(p.identity)}</span><span>${dlsEsc(p.genderAge)}</span></div>\n          <div class=\"dls-goal\"><span>CURRENT OBJECTIVE</span><strong>${dlsEsc(p.goal || \"依据当前事实继续行动\")}</strong></div>\n        </div>\n        <aside class=\"dls-command-cards\">\n          <article class=\"dls-command-card ${p.spValid ? \"\" : \"is-danger\"}\"><span>剩余 SP</span><strong>${dlsEsc(p.spValid ? p.sp : \"异常\")}</strong><small>${dlsEsc(p.spValid ? \"角色成长资源\" : p.spError)}</small></article>\n          <article class=\"dls-v2-readiness${toneClass(a.readinessTone)}\"><span>总体行动状态</span><strong>${dlsEsc(a.readiness)}</strong><small>${dlsEsc(a.limits)}</small></article>\n        </aside>\n        <div class=\"dls-hero-title-slots\" aria-label=\"当前装备称号\">${titleDisplay}</div>\n      </div>\n      <div class=\"dls-v2-reserves\">\n        ${reserveTrack(\"体能\", a.body, a.bodyTone)}\n        ${reserveTrack(\"魂力\", a.soul, a.soulTone)}\n        ${reserveTrack(\"精神\", a.spirit, a.spiritTone)}\n      </div>\n    </section>`;\n  }\n\n  function renderNav(state) {\n    const tabs = [[\"overview\", \"行动事实\"], [\"abilities\", \"能力武魂\"], [\"traits\", \"天赋与模板\"], [\"titles\", \"称号管理\"], [\"equipment\", \"装备物品\"], [\"world\", \"人物世界\"], [\"records\", \"剧情记忆\"]];\n    return `<nav class=\"dls-nav\" aria-label=\"状态栏页面\">${tabs.map(([id, name]) => `<button class=\"dls-tab ${state.tab === id ? \"is-active\" : \"\"}\" data-status-action=\"tab\" data-value=\"${id}\">${name}</button>`).join(\"\")}</nav>`;\n  }\n\n  function renderOverview(model) {\n    if (model.runtimeState.status !== \"legacy\") {\n      return `<div class=\"dls-status-deck\"><div class=\"dls-section-grid\">${renderRuntimeState(model.runtimeState)}</div></div>`;\n    }\n    const a = model.action;\n    const actionFacts = `<div class=\"dls-v2-fact-grid dls-command-grid\">\n      ${fact(\"当前行动限制\", [a.readiness, \"已建立事实\"], a.limits, a.readinessTone)}\n      ${fact(\"可用行动方向\", \"下一步判断\", a.options)}\n      ${a.warning ? fact(\"明确风险警告\", \"继续行动前必须知情\", a.warning, \"danger\") : \"\"}\n      ${a.reason ? fact(\"状态变化原因\", \"事实来源\", a.reason) : \"\"}\n    </div>`;\n    const injuries = model.injuries.map(row => `<article class=\"dls-v2-fact dls-v2-injury${toneClass(row.semanticTone)}\">\n      <header><span>${dlsEsc(row.location || \"未注明部位\")} · <em>${dlsEsc(row.severity || \"轻伤\")}</em></span></header>\n      <p>${dlsEsc(row.observable_fact || \"未记录可观察事实\")}</p>\n      <div class=\"dls-item-meta\">\n        <span class=\"dls-stat-pill\">影响：${dlsEsc(row.action_impact || \"待确认\")}</span>\n        <span class=\"dls-stat-pill\">失稳：${dlsEsc(row.instability || \"暂无\")}</span>\n        <span class=\"dls-stat-pill\">恶化：${dlsEsc(row.worsening_condition || \"待确认\")}</span>\n        <span class=\"dls-stat-pill\">临时稳定：${dlsEsc(row.stabilization_condition || \"待确认\")}</span>\n        <span class=\"dls-stat-pill\">治疗：${dlsEsc(row.treatment_condition || \"待确认\")}</span>\n        <span class=\"dls-stat-pill\">完整恢复：${dlsEsc(row.recovery_condition || \"待确认\")}</span>\n        <span class=\"dls-stat-pill\">恢复进展：${dlsEsc(row.recovery_status || \"未恢复\")}</span>\n        ${row.long_term_consequence ? `<span class=\"dls-stat-pill\">长期后果：${dlsEsc(row.long_term_consequence)}</span>` : \"\"}\n      </div>\n    </article>`).join(\"\") || empty(\"当前没有未解决伤势\");\n    const conditions = model.conditions.map(row => fact(row.name, [row.kind, row.status], [row.observable_fact, `行动影响：${row.action_impact || \"无明确影响\"}`, `维持条件：${row.maintenance_condition || \"未记录\"}`, `恶化条件：${row.worsening_condition || \"未记录\"}`, `结束条件：${row.end_condition || \"未记录\"}`, `交互限制：${row.interaction_limit || \"无明确限制\"}`, `恢复进展：${row.recovery_status || \"未记录\"}`].join(\"\\n\"), row.semanticTone)).join(\"\") || empty(\"当前没有持续状态\");\n    return `<div class=\"dls-status-deck\"><div class=\"dls-section-grid\">\n      ${renderRuntimeState(model.runtimeState)}\n      ${panel(\"行动判断\", \"PLAYER FACTS\", actionFacts)}\n      ${panel(\"具体伤势\", \"INJURIES\", `<div class=\"dls-v2-fact-grid\">${injuries}</div>`)}\n      ${panel(\"持续状态\", \"CONDITIONS\", `<div class=\"dls-v2-fact-grid\">${conditions}</div>`)}\n    </div></div>`;\n  }\n\n  function hasValue(value) {\n    return value === 0 || value === false || dlsTrim(value) !== \"\";\n  }\n\n  function detailText(row, fields) {\n    const lines = fields\n      .filter(([key]) => hasValue(row[key]))\n      .map(([key, label]) => `${label}：${row[key]}`);\n    return lines.join(\"\\n\") || \"暂无补充记录\";\n  }\n\n  function recordKey(row, prefix, index) {\n    return dlsTrim(prefix === \"soul\" ? row.soul_id : row.ability_id) || `${prefix}:row:${row.__rowIndex || row.row_id || index + 1}`;\n  }\n\n  function isRingAbility(row) {\n    if ([row.soul_ring_age, row.soul_ring_color, row.soul_beast_source].some(hasValue)) return true;\n    return /(魂环|魂技|武魂真身)/.test(`${dlsTrim(row.kind)} ${dlsTrim(row.sequence_stage)}`);\n  }\n\n  function chineseNumber(value) {\n    const digits = { \"零\": 0, \"〇\": 0, \"一\": 1, \"二\": 2, \"两\": 2, \"三\": 3, \"四\": 4, \"五\": 5, \"六\": 6, \"七\": 7, \"八\": 8, \"九\": 9 };\n    if (value === \"十\") return 10;\n    if (value.includes(\"十\")) {\n      const [left, right] = value.split(\"十\");\n      return (left ? digits[left] : 1) * 10 + (right ? digits[right] : 0);\n    }\n    return Array.from(value).reduce((number, char) => number * 10 + (digits[char] == null ? 0 : digits[char]), 0);\n  }\n\n  function ringSequence(row) {\n    const value = dlsTrim(row.sequence_stage);\n    const numberMatch = value.match(/\\d+/);\n    if (numberMatch) return Number(numberMatch[0]);\n    const chineseMatch = value.match(/[零〇一二两三四五六七八九十]+/);\n    return chineseMatch ? chineseNumber(chineseMatch[0]) : null;\n  }\n\n  function chineseAgeNumber(value) {\n    const digits = { \"零\": 0, \"〇\": 0, \"一\": 1, \"二\": 2, \"两\": 2, \"三\": 3, \"四\": 4, \"五\": 5, \"六\": 6, \"七\": 7, \"八\": 8, \"九\": 9 };\n    const units = { \"十\": 10, \"百\": 100, \"千\": 1000, \"万\": 10000 };\n    let total = 0;\n    let section = 0;\n    let number = 0;\n    for (const char of value) {\n      if (digits[char] != null) {\n        number = digits[char];\n        continue;\n      }\n      const unit = units[char];\n      if (!unit) continue;\n      if (unit === 10000) {\n        section += number;\n        total += (section || 1) * unit;\n        section = 0;\n        number = 0;\n      } else {\n        section += (number || 1) * unit;\n        number = 0;\n      }\n    }\n    return total + section + number;\n  }\n\n  function ageUnitMultiplier(unit) {\n    return unit === \"万\" ? 10000 : unit === \"千\" ? 1000 : unit === \"百\" ? 100 : 1;\n  }\n\n  function parseRingAgeYears(value) {\n    let text = dlsTrim(value);\n    if (!text) return null;\n    try { text = text.normalize(\"NFKC\"); } catch (_) {}\n    text = text.replace(/[,_，\\s]/g, \"\");\n    if (/(神环|神级)/.test(text)) return 1000000;\n\n    const numericRange = text.match(/(\\d+(?:\\.\\d+)?)\\s*(万|千|百)?\\s*(?:-|~|～|—|–|至|到)\\s*(\\d+(?:\\.\\d+)?)\\s*(万|千|百)?/);\n    if (numericRange) {\n      const sharedUnit = numericRange[2] || numericRange[4] || \"\";\n      const left = Number(numericRange[1]) * ageUnitMultiplier(numericRange[2] || sharedUnit);\n      const right = Number(numericRange[3]) * ageUnitMultiplier(numericRange[4] || sharedUnit);\n      return Math.min(left, right);\n    }\n\n    const chineseRange = text.match(/([零〇一二两三四五六七八九十百千万]+)(?:-|~|～|—|–|至|到)([零〇一二两三四五六七八九十百千万]+)/);\n    if (chineseRange) return Math.min(chineseAgeNumber(chineseRange[1]), chineseAgeNumber(chineseRange[2]));\n\n    const numeric = text.match(/(\\d+(?:\\.\\d+)?)\\s*(万|千|百)?(?:年|以上|左右|$)/);\n    if (numeric) return Number(numeric[1]) * ageUnitMultiplier(numeric[2] || \"\");\n\n    const chinese = text.match(/([零〇一二两三四五六七八九十百千万]+)(?:年|以上|左右|$)/);\n    return chinese ? chineseAgeNumber(chinese[1]) : null;\n  }\n\n  function ringTierFromYears(years) {\n    if (!Number.isFinite(years) || years <= 0) return null;\n    if (years >= 1000000) return 7;\n    if (years >= 200000) return 6;\n    if (years >= 100000) return 5;\n    if (years >= 10000) return 4;\n    if (years >= 1000) return 3;\n    if (years >= 100) return 2;\n    return 1;\n  }\n\n  function ringPalette(row) {\n    const explicit = dlsTrim(row.soul_ring_color);\n    const source = explicit || dlsTrim(row.soul_ring_age);\n    let key = \"unknown\";\n    if (/(七彩|七色|虹彩|彩虹|多彩|\\brainbow\\b)/i.test(source)) key = \"rainbow\";\n    else if (/(橙金|橙色|橙环|凶兽|\\borange\\b)/i.test(source)) key = \"orange\";\n    else if (/(金色|金环|百万|神级)/.test(source)) key = \"gold\";\n    else if (/(银色|银环|银白|\\bsilver\\b)/i.test(source)) key = \"silver\";\n    else if (/(青铜|铜色|铜环|棕色|\\bbronze\\b|\\bbrown\\b)/i.test(source)) key = \"bronze\";\n    else if (/(品红|洋红|玫红|紫红|\\bmagenta\\b)/i.test(source)) key = \"magenta\";\n    else if (/(粉色|粉红|粉环|桃红|\\bpink\\b)/i.test(source)) key = \"pink\";\n    else if (/(靛青|靛蓝|蓝紫|\\bindigo\\b)/i.test(source)) key = \"indigo\";\n    else if (/(青绿|碧绿|蓝绿|\\bteal\\b)/i.test(source)) key = \"teal\";\n    else if (/(绿色|绿环|翠绿|翡翠|\\bgreen\\b)/i.test(source)) key = \"green\";\n    else if (/(青色|青环|碧色|苍青|\\bcyan\\b)/i.test(source)) key = \"cyan\";\n    else if (/(蓝色|蓝环|苍蓝|\\bblue\\b)/i.test(source)) key = \"blue\";\n    else if (/(灰色|灰环|灰白|\\bgray\\b|\\bgrey\\b)/i.test(source)) key = \"gray\";\n    else if (/(白色|白环|\\bwhite\\b|十年)/i.test(source)) key = \"white\";\n    else if (/(黄色|黄环|\\byellow\\b|百年)/i.test(source)) key = \"yellow\";\n    else if (/(紫色|紫环|\\bpurple\\b|千年)/i.test(source)) key = \"purple\";\n    else if (/(红色|红环|\\bred\\b|十万年)/i.test(source)) key = \"red\";\n    else if (/(黑色|黑环|\\bblack\\b|万年)/i.test(source)) key = \"black\";\n    return { key, ...ringPalettes[key] };\n  }\n\n  function ringTier(row, palette = ringPalette(row)) {\n    const fromAge = ringTierFromYears(parseRingAgeYears(row.soul_ring_age));\n    if (fromAge) return { value: fromAge, source: \"age\" };\n    const traditionalColorTiers = { white: 1, yellow: 2, purple: 3, black: 4, red: 5, orange: 6, gold: 7, rainbow: 7 };\n    const fromColor = traditionalColorTiers[palette.key];\n    return fromColor ? { value: fromColor, source: \"color\" } : { value: 1, source: \"default\" };\n  }\n\n  function renderFields(row, fields, className = \"\") {\n    const content = fields.filter(([key]) => hasValue(row[key])).map(([key, label]) => {\n      if (className === \"dls-v2-dialog-field\") {\n        const wideField = ringDetailWideFields.has(key);\n        return wideField\n          ? `<div class=\"dls-v2-field dls-v2-dialog-field is-wide\" data-v2-field=\"${dlsEsc(key)}\"><dt>${dlsEsc(label)}</dt><dd>${dlsEsc(row[key])}</dd></div>`\n          : `<div class=\"dls-v2-field dls-v2-dialog-field\" data-v2-field=\"${dlsEsc(key)}\"><dt>${dlsEsc(label)}</dt><dd>${dlsEsc(row[key])}</dd></div>`;\n      }\n      return `<div class=\"dls-v2-field ${className}\" data-v2-field=\"${dlsEsc(key)}\">\n        <dt>${d