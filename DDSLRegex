":40},"exportConfig":{"enabled":true,"splitByRow":false,"entryName":"Danh hiệu đang có hiệu lực","entryType":"constant","keywords":"","preventRecursion":true,"entryPlacement":{"position":"at_depth_as_system","depth":0,"order":10003},"sqlInjectionTemplate":"\u003cQuy tắc kiểm định danh hiệu>\nDanh hiệu chỉ ảnh hưởng đến các kiểm định DP phi chiến đấu áp dụng rõ ràng. Tất cả danh hiệu áp dụng trong ba vị trí sẽ cộng dồn; trước tiên cộng biến động thuộc tính gốc 6 chiều của danh hiệu vào thuộc tính cơ bản, sau đó tính giá trị điều chỉnh theo floor((giá trị thuộc tính-10)/2).\nKiểm định = D20 được chọn + giá trị điều chỉnh thuộc tính + điều chỉnh cố định + xúc xắc bổ sung + điều chỉnh khác, đối kháng DC cơ bản + điều chỉnh DC danh hiệu. Số tầng ưu thế cộng lại và triệt tiêu với nhược thế: khi tổng số tầng S>0 thì đổ 1+S xúc xắc D20 lấy giá trị cao nhất, khi S\u003c0 thì đổ 1+|S| xúc xắc D20 lấy giá trị thấp nhất, khi S=0 thì đổ 1 xúc xắc D20.\nKịch bản áp dụng, phạm vi loại trừ, điều kiện hiệu lực và mất hiệu lực của văn bản tự do phải được phán quyết kết hợp với thực tế hiện tại; đặc quyền tường thuật không được bỏ qua các thực tế đã định, ranh giới năng lực và cái giá phải trả.\n\u003c/Quy tắc kiểm định danh hiệu>\n\u003cDanh hiệu đang có hiệu lực>\n{[sql \"SELECT et.slot AS Vị trí, tl.title_name AS Danh hiệu, tl.title_rank AS Cấp độ, tl.applicable_dp_attributes AS Thuộc tính DP áp dụng, tl.check_scope AS Kịch bản áp dụng, tl.excluded_scope AS Phạm vi loại trừ, printf('Ngộ tính:%+d;Khí trường:%+d;Bách công:%+d;Khí vận:%+d;Học thức:%+d;Duyệt lịch:%+d', tl.comprehension_delta, tl.presence_delta, tl.craft_delta, tl.luck_delta, tl.knowledge_delta, tl.experience_delta) AS Biến động thuộc tính gốc 6 chiều, tl.fixed_modifier AS Điều chỉnh kiểm định cố định, COALESCE(NULLIF(tl.bonus_dice, ''), 'Không') AS Xúc xắc bổ sung, tl.dc_modifier AS Điều chỉnh DC, tl.advantage_steps AS Số tầng ưu thế nhược thế, tl.narrative_privilege AS Đặc quyền tường thuật, tl.activation_condition AS Điều kiện hiệu lực, tl.expiry_condition AS Điều kiện mất hiệu lực FROM equipped_titles et JOIN title_library tl ON tl.title_id = et.title_id WHERE tl.is_equippable = 'Có' AND tl.status = 'Hiệu lực' ORDER BY CASE et.slot WHEN 'Danh hiệu 1' THEN 1 WHEN 'Danh hiệu 2' THEN 2 WHEN 'Danh hiệu 3' THEN 3 ELSE 99 END\"]}\n\u003c/Danh hiệu đang có hiệu lực>"}},{"key":"sheet_v2_soulBones","uid":"sheet_v2_soulBones","name":"Hồn cốt","physicalName":"soul_bones","group":"inventory","fields":["row_id","Mã hồn cốt","Tên hồn cốt","Loại hồn cốt","Bộ phận dung hợp","Nguồn gốc và thực tế thu được","Niên hạn hồn cốt","Phẩm chất hồn cốt","Người sở hữu hiện tại","Thực tế dung hợp","Ngoại hình và chất liệu cốt lõi","Quan hệ bộ và thành phần","Mã kỹ năng hồn cốt liên quan","Thực tế hiệu quả đã xác nhận","Ảnh hưởng phát động và hành động","Hạn chế sử dụng và xung đột bài xích","Nguyên vẹn, tổn hại và sửa chữa","Điều kiện và hậu quả bóc tách","Năng lực nhân vật và sự kiện liên quan","Ghi chú"],"physicalFields":["row_id","bone_id","name","kind","body_slot","source_fact","age","quality","owner","fusion_fact","appearance_material","set_fact","attached_ability_ids","effect_fact","activation_impact","restriction_conflict","condition_repair","removal_fact","related_ids","notes"],"physicalToDisplay":{"row_id":"Mã hàng","bone_id":"Mã hồn cốt","name":"Tên hồn cốt","kind":"Loại hồn cốt","body_slot":"Bộ phận dung hợp","source_fact":"Nguồn gốc và thực tế thu được","age":"Niên hạn hồn cốt","quality":"Phẩm chất hồn cốt","owner":"Người sở hữu hiện tại","fusion_fact":"Thực tế dung hợp","appearance_material":"Ngoại hình và chất liệu cốt lõi","set_fact":"Quan hệ bộ và thành phần","attached_ability_ids":"Mã kỹ năng hồn cốt liên quan","effect_fact":"Thực tế hiệu quả đã xác nhận","activation_impact":"Ảnh hưởng phát động và hành động","restriction_conflict":"Hạn chế sử dụng và xung đột bài xích","condition_repair":"Nguyên vẹn, tổn hại và sửa chữa","removal_fact":"Điều kiện và hậu quả bóc tách","related_ids":"Năng